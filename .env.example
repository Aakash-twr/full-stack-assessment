# ── Database ──────────────────────────────────────────────────────────────────
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://txn_user:txn_password@localhost:3306/transactions_db

# ── Worker tuning ─────────────────────────────────────────────────────────────
# Seconds to simulate external payment-processor call (set to 2 in tests)
PROCESSING_DELAY_SECONDS=30

# How often the worker polls for new jobs (seconds)
WORKER_POLL_INTERVAL_SECONDS=1

# Duration a worker holds a lease before it is considered abandoned (seconds)
JOB_LEASE_SECONDS=120

# Maximum processing attempts before a transaction is marked FAILED
MAX_ATTEMPTS=5

# Base delay for exponential back-off between retries (seconds)
RETRY_BASE_DELAY_SECONDS=5

# ── API server ────────────────────────────────────────────────────────────────
PORT=8000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
